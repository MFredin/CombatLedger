{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CombatLedger",
  "version": "0.1.0",
  "identifier": "com.combatledger.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CombatLedger",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "settings",
        "title": "CombatLedger — Settings",
        "width": 480,
        "height": 340,
        "visible": false,
        "resizable": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns", "icons/icon.ico"]
  }
}
