{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CombatLedger",
  "version": "1.3.6",
  "identifier": "com.combatledger.companion",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CombatLedger",
        "width": 800,
        "height": 600,
        "visible": false
      },
      {
        "label": "settings",
        "title": "CombatLedger \u2014 Settings",
        "width": 480,
        "height": 340,
        "visible": false,
        "resizable": false
      }
    ],
    "trayIcon": {
      "id": "main",
      "iconPath": "icons/icon.png"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Post-combat analysis companion for WoW",
    "longDescription": "CombatLedger Companion watches your WoWCombatLog.txt in real time, parses encounter events, and writes enriched analysis data to your WoW SavedVariables so the in-game addon can display death recaps, interrupt reports, CC coverage, and performance trends without leaving the game.",
    "publisher": "MFredin",
    "copyright": "\u00a9 2026 MFredin",
    "windows": {
      "wix": {
        "language": "en-US"
      },
      "nsis": {
        "languages": [
          "English"
        ],
        "displayLanguageSelector": false,
        "installMode": "perMachine",
        "installerIcon": "icons/icon.ico",
        "headerImage": "icons/installer-header.bmp",
        "sidebarImage": "icons/installer-sidebar.bmp"
      }
    },
    "macOS": {
      "dmg": {
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        },
        "windowSize": {
          "width": 660,
          "height": 400
        }
      },
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1"
        ]
      }
    }
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/MFredin/CombatLedger/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEY3NjQwNzVCOUU1QjU5NzMKUldSeldWdWVXd2RrOXg5VmxaL3hjODQ1SUpJNTJYMGxTTk5HOVo0RzgxVXJoL09pVmQweERJRnAK"
    }
  }
}
